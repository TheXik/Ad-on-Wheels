@startuml use-case-diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Latin Modern Roman"
skinparam defaultFontSize 12
skinparam actorStyle awesome

' ACTORS
actor "Unregistered\nUser" as UU
actor Driver as D
actor Company as C
actor "Administrator\n(future scope)" as A #lightgray;line:gray;line.dashed

rectangle "Ad-on-Wheels Platform" {

    package "Accounts" {
        usecase "UC09 Register" as UC09
        usecase "UC10/12 Log In" as UC10
    }

    package "Driver" {
        usecase "UC02 Browse Campaigns" as UC02
        usecase "UC02a Apply to Campaign" as UC02a
        usecase "UC03 Inspect Campaign Details" as UC03
        usecase "UC01 Log a Ride\n(QR verification)" as UC01
        usecase "UC13 Reconstruct\nDeferred Ride" as UC13
        usecase "UC04 View Earnings\n& Statistics" as UC04
        usecase "Upload Weekly\nVerification Photo" as UC_Photo
    }

    package "Company" {
        usecase "UC06 View Active /\nPast Campaigns" as UC06
        usecase "Create Campaign" as UC_Create
        usecase "UC07 Review Driver\nApplications" as UC07
        usecase "UC08 Export\nCampaign Statistics" as UC08
    }

    usecase "UC05 Exchange Messages\n(per campaign)" as UC05
}

UU --> UC09
UU --> UC10

D --> UC10
D --> UC02
D --> UC03
D --> UC01
D --> UC13
D --> UC04
D --> UC_Photo
D --> UC05

C --> UC10
C --> UC06
C --> UC_Create
C --> UC07
C --> UC08
C --> UC05

UC02a .> UC02 : <<extend>>
UC03 .> UC02 : <<extend>>
UC13 .> UC01 : <<extend>>\n(fallback when ride\nwas not started)

note bottom of A
  Reserved for future scope.
  The backend already defines
  Role.ADMIN in its user-role
  enum, but no administrator
  use cases are implemented
  in this thesis.
end note

@enduml
