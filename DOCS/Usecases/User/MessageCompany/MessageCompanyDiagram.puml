@startuml MessageCompany
actor Driver

Driver -> App : Tap "Messages" (with unread-count badge, FR.24)
App -> Backend : Fetch conversation threads (one per campaign)
Backend -> App : Thread list ordered by last activity

alt Threads exist
    App -> Driver : Display thread list
    Driver -> App : Select thread
    App -> Backend : Mark incoming messages in thread as read
    Backend -> App : OK (unread counter updated)
    App -> Driver : Render chronological conversation (FR.25)

    alt Compose reply or new message
        Driver -> App : Type and send message
        App -> Backend : Persist + deliver
        alt Delivery succeeds
            Backend -> App : Delivered
            App -> Driver : Append message to thread with status
        else Delivery fails
            Backend -> App : Error
            App -> Driver : Mark message as "failed" + Retry action
        end
    end

else No threads yet
    App -> Driver : Show empty state
end

@enduml
