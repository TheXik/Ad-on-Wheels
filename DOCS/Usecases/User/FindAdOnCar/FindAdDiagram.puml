@startuml FindAd
actor Driver

Driver -> App : Navigate to "Find Ad" screen
App -> Backend : Fetch recruiting campaigns
Backend -> App : Campaign list

loop until list exhausted
    App -> Driver : Present one campaign (name, company, reward, duration, vehicle)

    alt Affirmative gesture (apply)
        Driver -> App : Single affirmative gesture
        App -> Backend : Submit application (status = pending)
        Backend -> App : OK
        App -> Driver : Show next campaign
    else Dismissive gesture (skip)
        Driver -> App : Single dismissive gesture
        App -> App : Mark campaign skipped (session-local)
        App -> Driver : Show next campaign
    else Open for details (UC03)
        Driver -> App : Tap "Details"
        App -> Driver : Open campaign detail view
    else Reverse last action
        Driver -> App : Tap "Undo"
        alt Last action was skip
            App -> Driver : Restore skipped campaign
        else Last action was apply
            App -> Backend : Withdraw application
            Backend -> App : OK
            App -> Driver : Campaign restored for action
        end
    end
end

alt No recruiting campaigns / list exhausted
    App -> Driver : Show empty state + "Refresh"
end

alt Application submission fails
    Backend -> App : Error
    App -> Driver : Show error, campaign remains available for retry
end

@enduml
