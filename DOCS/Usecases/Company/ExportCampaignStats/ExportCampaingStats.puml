@startuml ExportCampaignStats
actor Company

Company -> App : Navigate to "Stats" or campaign detail
App -> Backend : Fetch campaign metrics
Backend -> App : Metrics

alt Data available
    Company -> App : Choose export scope

    alt Single campaign
        Company -> App : Select campaign + click Export
    else All campaigns
        Company -> App : Click Export on aggregate view
    end

    App -> Backend : Request CSV export (scope)
    Backend -> Backend : Generate CSV encoded in UTF-8 (C.8)

    alt Generation successful
        Backend -> App : CSV file (text/csv; charset=UTF-8)
        App -> Company : Deliver file for download
    else Generation failed
        Backend -> App : Error
        App -> Company : Show "Unable to generate export. Please retry." + Retry
    end

else No data to export
    App -> Company : Disable Export button with tooltip "No data available to export"
end

@enduml
