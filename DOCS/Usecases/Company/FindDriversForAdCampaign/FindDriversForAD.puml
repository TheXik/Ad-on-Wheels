@startuml FindDriversForAdCampaign
actor Company

Company -> App : Navigate to "Find Drivers"
App -> Backend : Fetch campaigns with pending applications
Backend -> App : Campaign list

alt Campaigns available
    Company -> App : Select campaign
    App -> Backend : Fetch pending applications
    Backend -> App : Applications (driver name, vehicle, rating)

    alt Applications exist
        App -> Company : Display list with filters & sort
        Company -> App : Apply filters / search
        Company -> App : Select a single application
        App -> Company : Show full driver profile (compliance, projected reach)
        Company -> App : Click Accept or Decline
        App -> Backend : Persist decision

        alt Success
            Backend -> App : OK
            note right
                On accept:
                - Driver added to participants
                - Eligible for messaging (UC05 / FR.23)
                - Decrement remaining-driver-slots counter
            end note
            App -> Company : Refresh list, continue review
        else Failure
            Backend -> App : Error
            App -> Company : Preserve previous state, surface error
        end

    else No applications
        App -> Company : Show empty state + "Share Campaign" action
    end

else No campaigns with pending applications
    App -> Company : Show empty state + shortcut to create campaign (FR.16)
end

@enduml
