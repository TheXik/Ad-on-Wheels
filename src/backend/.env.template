# Copy this file to .env and fill the values for your local environment.
# .env is gitignored; do not commit secrets to the repository.

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# Google OAuth client IDs (comma-separated: iOS, Web)
# Created in https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_IDS=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=campaign-images

# Gateway CORS allowed origins (comma-separated, supports wildcards)
# Add your production domain here, e.g.
# GATEWAY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://app.example.com
GATEWAY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
